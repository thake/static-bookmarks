  <section id="social" class="social">
    <div class="social-content">
        <div class="contact-form" data-aos="fade-up" data-aos-delay="100">
            <h2>Contact with us</h2>
            <div id="notification" class='success-notification' style="padding: 20px;">
            </div>
            <form class="contact">
                <input type="email" id="contact_address" placeholder="Your email address" name="email">
                <textarea name="body" id="contact_send" placeholder="Comment…" rows="8"></textarea>
                <button type="button" id="submit_btn">Send</button>
            </form>
        </div>
        <div class="bluesky-feed" data-aos="fade-up" data-aos-delay="300">
            <script type="module" src="https://cdn.jsdelivr.net/npm/bsky-embed/dist/bsky-embed.es.js" async></script>
            <bsky-embed 
                username="kotlinweekly.bsky.social" 
                max-width="500" 
                limit="5"
                custom-styles=".container { background: transparent; border: none; }">
            </bsky-embed>
        </div>
        <script>


            const docRefContact = db.collection("KotlinContact");

            const inputFieldSocial = document.querySelector("#contact_send");
            const inputFieldAddress = document.querySelector("#contact_address");
            const submitButtonSocial = document.querySelector("#submit_btn");

            submitButtonSocial.addEventListener("click", function () {
                const inputData = inputFieldSocial.value.trim();
                const inputAddress = inputFieldAddress.value.trim();

                const notification = document.getElementById("notification");

                // Validation: ask for more detail on empty or single-word entries
                if (!inputData || inputData.split(/\s+/).length < 2) {
                    notification.innerHTML = "Please write a bit more about your request";
                    notification.style.backgroundColor = "lightcoral";
                    return;
                }

                if (!inputAddress) {
                    notification.innerHTML = "Please enter your email address";
                    notification.style.backgroundColor = "lightcoral";
                    return;
                }

                inputFieldSocial.value = "";
                inputFieldAddress.value = "";
                notification.innerHTML = "Thank you for your message! We will get back to you soon";
                notification.style.backgroundColor = "darkseagreen";

                docRefContact.add({
                    message: inputData,
                    address: inputAddress,
                    time: Date()
                }).then(function () {
                    console.log("Document written with ID");
                }).catch(function (error) {
                    console.error("Error adding document: ", error);
                });
            });
                } else {
                    console.log("Invalid input detected. Message not stored in Firestore.");
                }
            });

        </script>
    </div>
</section>

