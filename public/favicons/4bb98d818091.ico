 dark:text-gray-400"><!--[0--><a href="/google" class="inline-flex min-w-0 max-w-full items-center rounded-full border border-blue-200/70 bg-blue-50 py-0.5 text-blue-700 hover:border-blue-200 hover:bg-blue-100 dark:border-blue-500/20 dark:bg-blue-900/30 dark:text-blue-300 dark:hover:border-blue-500/30 dark:hover:bg-blue-900/50 px-1.5 text-xs gap-1 "><!--[0--><img src="https://cdn-avatars.huggingface.co/v1/production/uploads/5dd96eb166059660ed1ee413/WtA3YYitedOr9n02eHfJe.png" alt="google" class="size-3 rounded-sm"/><!--]--> <span class="block min-w-0 truncate font-medium">Google</span></a><!--]--> <!--[0--><span class="mx-1">·</span> <span>Oct 9, 2026</span><!--]--></div> <div class="flex flex-col gap-2"><div class="flex flex-wrap items-center gap-2.5 pt-1 !pt-0 z-1 lg:sticky lg:top-8"><!--[0--><a href="/login?next=%2Fpapers%2F2610.14224" class="self-start"><!--[0--><!----><div role="checkbox" class="shadow-alternate group flex h-9 cursor-pointer select-none items-center gap-2 rounded-lg border pl-3 pr-3.5 border-gray-300 bg-white dark:bg-gray-850 w-full justify-center"><input disabled="" type="checkbox" class="peer hidden"/> <svg class="text-xs text-gray-500 peer-checked:text-gray-500 group-hover:text-orange-500" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" height="1em" preserveAspectRatio="xMidYMid meet" viewBox="0 0 12 12"><path fill="currentColor" d="M5.19 2.67a.94.94 0 0 1 1.62 0l3.31 5.72a.94.94 0 0 1-.82 1.4H2.7a.94.94 0 0 1-.82-1.4l3.31-5.7v-.02Z"></path></svg><!----> Upvote <div class="font-semibold text-orange-500">67</div><!----></div><!----><!--]--> <!--[-1--><!--]--><!----></a><!--]--> <!--[-1--><!--]--></div> <!--[-1--><!--]--> <dialog class="shadow-alternate z-40 mx-4 my-auto h-fit select-text overflow-hidden rounded-xl bg-white max-sm:max-w-[calc(100dvw-2rem)] sm:mx-auto lg:mt-26 md:portrait:mt-30 xl:mt-30 2xl:mt-32 w-full sm:w-96 max-w-[calc(100%-4rem)] text-base  "><div tabin