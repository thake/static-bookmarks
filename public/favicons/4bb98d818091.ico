hidden bg-white dark:border-gray-800 max-md:border-b md:border-r"><video src="https://cdn-uploads.huggingface.co/production/uploads/635035fedc10894a3f66ea79/UrZokT3Jy-H4c8Nh8-Gh_.mp4" loop="" muted="" playsinline="" preload="metadata" class="pointer-events-none size-full object-cover object-center"></video></a><!--]--> <!--[0--><div class="shadow-xs pointer-events-none absolute bottom-2 right-2 flex h-6 items-center gap-1 whitespace-nowrap rounded-md border bg-white px-2 text-xs leading-none text-gray-700 dark:bg-gray-900 dark:text-gray-400">Submitted by <div class="flex-none  "><img alt="" loading="lazy" class="max-w-none size-2.5 rounded-full  flex-none select-none " src="/avatars/bcf0a00a7290b822e00fbe0930bd9160.svg" crossorigin="anonymous"/> <!--[-1--><!--]--></div><!----> jgkwak</div><!--]--></div> <div class="from-gray-50-to-white bg-linear-to-b p-4"><h3 class="mb-2 text-lg font-semibold text-gray-900 hover:underline dark:text-white"><a href="/papers/2611.02857" class="line-clamp-2 cursor-pointer">Solv3R: 3D Looped Transformer as a Multi-view Solver</a></h3> <!--[0--><div class="mb-2"><p class="line-clamp-2 text-sm text-gray-600 dark:text-gray-300">Solv3R is a looped transformer that iteratively refines multi-view geometry from its current state, supporting incremental updates, caching, and multiple reconstruction tasks without specialized modules.</p></div><!--]--> <div class="mb-3 flex items-center text-sm text-gray-500 dark:text-gray-400"><!--[-1--><!--[0--><ul class="flex items-center text-gray-600  flex-row-reverse    text-xs mr-1.5"><!--[--><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Kwang Moo Yi" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Yuki Ono" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Sho Kagami" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Andrea Tagliasacchi" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="jgkwak" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="/avatars/bcf0a00a7290b822e00fbe0930bd9160.svg" loading="lazy"/><!--]--></li><!--]--> <!--[0--><li class="text-xs hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 order-first ml-2"><!--[0--><span>5 authors</span><!----><!--]--></li><!--]--></ul><!--]--><!--]--> <!--[0--><span class="mx-1">·</span> <span>Nov 2, 2026</span><!--]--></div> <div class="flex flex-col gap-2"><div class="flex flex-wrap items-center gap-2.5 pt-1 !pt-0 z-1 lg:sticky lg:top-8"><!--[0--><a href="/login?next=%2Fpapers%2F2611.02857" class="self-start"><!--[0--><!----><div role="checkbox" class="shadow-alternate group flex h-9 cursor-pointer select-none items-center gap-2 rounded-lg border pl-3 pr-3.5 border-gray-300 bg-white dark:bg-gray-850 w-full justify-center"><input disabled="" type="checkbox" class="peer hidden"/> <svg class="text-xs text-gray-500 peer-checked:text-gray-500 group-hover:text-orange-500" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" width="1em" heig