ull object-cover object-center"></video></a><!--]--> <!--[0--><div class="shadow-xs pointer-events-none absolute bottom-2 right-2 flex h-6 items-center gap-1 whitespace-nowrap rounded-md border bg-white px-2 text-xs leading-none text-gray-700 dark:bg-gray-900 dark:text-gray-400">Submitted by <div class="flex-none  "><img alt="" loading="lazy" class="max-w-none size-2.5 rounded-full  flex-none select-none " src="/avatars/bcf0a00a7290b822e00fbe0930bd9160.svg" crossorigin="anonymous"/> <!--[-1--><!--]--></div><!----> jgkwak</div><!--]--></div> <div class="from-gray-50-to-white bg-linear-to-b flex min-w-0 flex-1 flex-col justify-center p-6"><h3 class="mb-1.5 text-xl font-semibold text-gray-900 hover:underline dark:text-white"><a href="/papers/2611.02857" class="line-clamp-2 cursor-pointer text-balance">Solv3R: 3D Looped Transformer as a Multi-view Solver</a></h3> <!--[0--><div class="mb-2"><p class="line-clamp-2 text-sm text-gray-500 dark:text-gray-400">Solv3R is a looped transformer that iteratively refines multi-view geometry from its current state, supporting incremental updates, caching, and multiple reconstruction tasks without specialized modules.</p></div><!--]--> <div class="flex min-w-0 items-center text-sm text-gray-400 dark:text-gray-500"><!--[-1--><!--[0--><ul class="flex items-center text-gray-600  flex-row-reverse    text-xs mr-1.5"><!--[--><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Kwang Moo Yi" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Yuki Ono" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounde