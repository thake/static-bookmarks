apers/2309.06180.png" decoding="async" alt="" class="size-full object-cover object-center opacity-80 dark:opacity-70 dark:invert invisible" onload="this.__e=event" onerror="this.__e=event"/></div><!----></a><!--]--> <!--[0--><div class="shadow-xs pointer-events-none absolute bottom-2 right-2 flex h-6 items-center gap-1 whitespace-nowrap rounded-md border bg-white px-2 text-xs leading-none text-gray-700 dark:bg-gray-900 dark:text-gray-400">Submitted by <div class="flex-none  "><img alt="" loading="lazy" class="max-w-none size-2.5 rounded-full  flex-none select-none " src="https://cdn-avatars.huggingface.co/v1/production/uploads/1674929746905-60f1abe7544c2adfd699860c.jpeg" crossorigin="anonymous"/> <!--[-1--><!--]--></div><!----> akhaliq</div><!--]--></div> <div class="from-gray-50-to-white bg-linear-to-b p-4"><h3 class="mb-2 text-lg font-semibold text-gray-900 hover:underline dark:text-white"><a href="/papers/2309.06180" class="line-clamp-2 cursor-pointer">Efficient Memory Management for Large Language Model Serving with
  PagedAttention</a></h3> <!--[0--><div class="mb-2"><p class="line-clamp-2 text-sm text-gray-600 dark:text-gray-300">PagedAttention algorithm and vLLM system enhance the throughput of large language models by efficiently managing memory and reducing waste in the key-value cache.</p></div><!--]--> <div class="mb-3 flex items-center text-sm text-gray-500 dark:text-gray-400"><!--[-1--><!--[0--><ul class="flex items-center text-gray-600  flex-row-reverse    text-xs "><!--[--><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="ProfJoeyG" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="/avatars/e0d0ec2bad4dd59b9169d445a1ffa1d4.svg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="comaniac" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="/avatars/54e2f8948468435905f9b26b0f22f917.svg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="ying1123" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="https://cdn-avatars.huggingface.co/v1/production/uploads/6455b969654d8bccae50736c/WsK0_sbQSVeosi-fh-O_U.jpeg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="zhuohan123" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="https://cdn-avatars.huggingface.co/v1/pro